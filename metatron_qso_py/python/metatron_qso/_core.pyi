    def average_distribution(self, start: int, t_max: float) -> RealArray: ...
    def mixing_time(
        self, start: int, epsilon: float, t_max: float, steps: int = 200
    ) -> Optional[float]: ...
    def propagator(self, t: float) -> ComplexArray: ...
    @property
    def spectrum(self) -> Optional[RealArray]: ...
    @property
    def num_nodes(self) -> int: ...
    @property
    def gamma(self) -> float: ...
    @property
    def generator(self) -> str: ...

class SearchResult(TypedDict):
    gamma: float
    time: float
    success_probability: float
    expected_time: float

